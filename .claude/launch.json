{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "server",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--workspace=@vtt/server"
      ],
      "port": 3001
    },
    {
      "name": "server-dev-account",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--workspace=@vtt/server"
      ],
      "env": {
        "SEED_DEV_ACCOUNT": "1"
      },
      "port": 3001
    },
    {
      "name": "server-compose",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--workspace=@vtt/server"
      ],
      "env": {
        "DATABASE_URL": "postgres://vtt:vtt@127.0.0.1:5432/vtt",
        "REDIS_URL": "redis://127.0.0.1:6379",
        "S3_ENDPOINT": "http://127.0.0.1:8333"
      },
      "port": 3001
    },
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--workspace=@vtt/web"
      ],
      "env": {
        "VTT_SERVER": "http://127.0.0.1:3001"
      },
      "port": 5173
    },
    {
      "name": "server-isolated",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--workspace=@vtt/server"
      ],
      "env": {
        "PORT": "3101",
        "SEED_DEV_ACCOUNT": "1"
      },
      "port": 3101
    },
    {
      "name": "web-isolated",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--workspace=@vtt/web",
        "--",
        "--port",
        "5273",
        "--strictPort"
      ],
      "env": {
        "VTT_SERVER": "http://127.0.0.1:3101"
      },
      "port": 5273
    },
    {
      "name": "server-isolated-2",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--workspace=@vtt/server"
      ],
      "env": {
        "PORT": "3201",
        "SEED_DEV_ACCOUNT": "1"
      },
      "port": 3201
    },
    {
      "name": "web-isolated-2",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--workspace=@vtt/web",
        "--",
        "--port",
        "5373",
        "--strictPort"
      ],
      "env": {
        "VTT_SERVER": "http://127.0.0.1:3201"
      },
      "port": 5373
    }
  ]
}
