{
  "name": "@vtt/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --exclude test/ephemeralLatency.test.ts",
    "test:bench": "vitest run test/ephemeralLatency.test.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "account:reset-password": "tsx src/scripts/resetPassword.ts",
    "uploads:backfill-sizes": "tsx src/scripts/backfillUploadSizes.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1137.0",
    "@node-rs/argon2": "^2.2.1",
    "@prisma/client": "^6.19.3",
    "@vtt/shared": "*",
    "bullmq": "^5.81.5",
    "express": "^5.2.1",
    "ioredis": "^6.0.0",
    "multer": "^2.4.0",
    "sharp": "^0.35.5",
    "socket.io": "^4.8.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.20.3",
    "@types/ws": "^8.18.1",
    "prisma": "^6.2.1",
    "socket.io-client": "^4.8.3",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7",
    "ws": "^8.21.3"
  }
}
