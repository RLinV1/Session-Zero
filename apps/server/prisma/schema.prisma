// Event store schema (DESIGN.md §2 "PostgreSQL + Prisma", §5; docs/adr/0001-event-model.md).
//
// `events` is append-only: rows are never updated or deleted, and undo is a new
// compensating event (FR-REC-03). The one exception is deleting a whole room, which
// erases its log together with the room (docs/adr/0009-room-deletion.md). Postgres enforces
// this with triggers (migration 0007_events_insert_only, KAN-42). The per-room ordering guarantee (FR-SYNC-04) lives in
// the composite primary key below, not in application code — a duplicate seq is a
// constraint violation no matter which instance tried to write it.
//
//   npx prisma migrate dev --name init     # create/apply a migration
//   npx prisma generate                    # regenerate the client after a schema edit

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// A private draft an AI fills and its owner reviews and publishes (FR-GM-26, ADR 0053).
model Build {
  id            String    @id @db.Uuid
  ownerGmId     String    @map("owner_gm_id") @db.Uuid
  name          String
  status        String    @default("open")
  gameProfile   Json?     @map("game_profile")
  /// SHA-256 of the build pass. Null when there is no live pass; the pass itself is never stored.
  studioIntake  Json?     @map("studio_intake")
  studioFileId  String?   @map("studio_file_id") @db.Uuid
  studioContext Json?     @map("studio_context")
  studioOutcomes Json?    @map("studio_outcomes")
  passHash      String?   @unique @map("pass_hash")
  passExpiresAt DateTime? @map("pass_expires_at") @db.Timestamptz(6)
  /// The owner's choices (ADR 0053): let the AI's grid count when detection agrees, and let it set walls, doors and windows.
  aiGrid        Boolean   @default(false) @map("ai_grid")
  aiWalls       Boolean   @default(false) @map("ai_walls")
  /// The owner's choice (ADR 0071): let the AI propose permanent Difficult and Blocked squares.
  aiTerrain     Boolean   @default(false) @map("ai_terrain")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  owner GmIdentity  @relation(fields: [ownerGmId], references: [id])
  files BuildFile[]
  items BuildItem[]
  studioWorkspaces StudioAuthoringWorkspace[]
  studioChatSelections StudioChatSelection[]
  studioPublications StudioPublication[]

  @@index([ownerGmId, status])
  @@index([status, updatedAt])
  @@map("builds")
}

/// One opt-in private authoring history per draft map (ADR 0073).
model StudioAuthoringWorkspace {
  buildId String @map("build_id") @db.Uuid
  mapKey String @map("map_key")
  state Json
  build Build @relation(fields: [buildId], references: [id], onDelete: Cascade)
  entries StudioAuthoringEntry[]

  @@id([buildId, mapKey])
  @@map("studio_authoring_workspaces")
}

/// Immutable revision, request or idempotency receipt.
model StudioAuthoringEntry {
  buildId String @map("build_id") @db.Uuid
  mapKey String @map("map_key")
  kind String
  id String @db.Uuid
  value Json
  activity Json?
  workspace StudioAuthoringWorkspace @relation(fields: [buildId, mapKey], references: [buildId, mapKey], onDelete: Cascade)

  @@id([buildId, kind, id])
  @@index([buildId, mapKey, kind])
  @@map("studio_authoring_entries")
}

/// A map or token image in a build. Its object stays put when published (FR-GM-27).
model BuildFile {
  id                  String    @id @db.Uuid
  buildId             String    @map("build_id") @db.Uuid
  kind                String
  objectKey           String    @map("object_key")
  url                 String
  studio              Json?
  originalName        String    @map("original_name")
  width               Int
  height              Int
  sizeBytes           Int       @map("size_bytes")
  /// Set only by a UVTT file, which is exact.
  grid                Json?
  board               Json?
  sourceHash          String?   @map("source_hash")
  detectionSourceHash String?   @map("detection_source_hash")
  detectionVersion    String?   @map("detection_version")
  detectionError      String?   @map("detection_error")
  detectionStatus     String?   @map("detection_status")
  detectionAttempt    Int       @default(0) @map("detection_attempt")
  detectionResult     Json?     @map("detection_result")
  detectionUpdatedAt  DateTime? @map("detection_updated_at") @db.Timestamptz(6)
  publishedAssetId    String?   @map("published_asset_id") @db.Uuid
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  build Build @relation(fields: [buildId], references: [id])

  @@index([buildId, kind])
  @@index([detectionStatus])
  @@map("build_files")
}

/// A draft creature, map or encounter, saved by the key the AI chose.
model BuildItem {
  id             String   @id @db.Uuid
  buildId        String   @map("build_id") @db.Uuid
  kind           String
  key            String
  data           Json
  flags          Json     @default("[]")
  notCarriedOver String   @default("") @map("not_carried_over")
  editedByUser   Boolean  @default(false) @map("edited_by_user")
  publishedId    String?  @map("published_id") @db.Uuid
  updatedAt      DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  build Build @relation(fields: [buildId], references: [id])

  @@unique([buildId, kind, key])
  @@map("build_items")
}

model Room {
  id         String   @id @db.Uuid
  inviteCode String   @unique @map("invite_code")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  /// GM device identity that created the room (ADR 0004). Null for rooms made before it existed.
  ownerGmId  String?  @map("owner_gm_id") @db.Uuid
  /// Denormalised from RoomCreated so the dashboard need not replay the log.
  name       String?
  /// A private room for editing an encounter template (ADR 0033): hidden from room lists, closed
  /// to joins, deleted on leave or by the sweep.
  temporary        Boolean @default(false)
  /// The template a temporary room saves to; null until a new template's first save.
  editsEncounterId String? @map("edits_encounter_id") @db.Uuid

  owner       GmIdentity?  @relation(fields: [ownerGmId], references: [id])
  editsEncounter EncounterTemplate? @relation(fields: [editsEncounterId], references: [id], onDelete: SetNull)
  events      Event[]
  credentials Credential[]
  snapshots   Snapshot[]
  checkpoints Checkpoint[]
  assetRefs   AssetRef[]
  uploads     RoomUpload[]
  members     RoomMember[]

  @@index([ownerGmId])
  @@index([temporary, createdAt])
  @@map("rooms")
}

/// An owner of rooms and library items (ADR 0004, ADR 0017). Despite the table name it now
/// holds two kinds of row: one per account (`users.owner_id`, no token), and legacy GM device
/// identities from before accounts, which store only their token's SHA-256. The device-identity
/// removal follow-up renames the table to `owners`.
model GmIdentity {
  id        String   @id @db.Uuid
  tokenHash String?  @unique @map("token_hash")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  /// Set once the shipped maps were added to this owner's library (ADR 0036); never cleared.
  shippedMapsSeededAt DateTime? @map("shipped_maps_seeded_at") @db.Timestamptz(6)
  /// Slugs of the shipped maps already added to this owner's library; never shrinks, so a deleted map stays deleted.
  shippedMapsSeeded String[] @default([]) @map("shipped_maps_seeded")
  /// The owner's defaults for new rooms (ADR 0066), as `RoomDefaults`; null until first saved.
  roomDefaults Json? @map("room_defaults")
  /// A guest GM identity (guest-gm-hosting D1): hosts guest rooms with no account. False for accounts and pre-account devices.
  guest Boolean @default(false)

  rooms     Room[]
  assets    LibraryAsset[]
  creatures LibraryCreature[]
  diceLooks DiceLook[]
  animations LibraryAnimation[]
  encounters EncounterTemplate[]
  builds    Build[]
  studioGrants StudioGrant[]
  user      User?

  @@map("gm_identities")
}

/// A public client registered through dynamic client registration (RFC 7591) for delegated
/// Studio access (FR-GM-26, ADR 0073, design D7). Bounded in number; unused ones expire.
model StudioOAuthClient {
  id           String    @id
  name         String
  redirectUris String[]  @map("redirect_uris")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  lastUsedAt   DateTime? @map("last_used_at") @db.Timestamptz(6)

  grants StudioGrant[]

  @@index([createdAt])
  @@map("studio_oauth_clients")
}

/// One owner's consent to one client for chosen builds, and the token family it starts (design D7).
/// Revoking it ends every token in it. Only the authorization code's SHA-256 is stored.
model StudioGrant {
  id            String    @id @db.Uuid
  ownerGmId     String    @map("owner_gm_id") @db.Uuid
  clientId      String    @map("client_id")
  resource      String
  scope         String
  buildIds      String[]  @map("build_ids") @db.Uuid
  /// Legacy opt-in column retained for rollback to the first M4 release.
  correctionBuildIds String[] @default([]) @map("correction_build_ids") @db.Uuid
  codeHash      String    @unique @map("code_hash")
  codeChallenge String    @map("code_challenge")
  redirectUri   String    @map("redirect_uri")
  codeExpiresAt DateTime  @map("code_expires_at") @db.Timestamptz(6)
  codeUsedAt    DateTime? @map("code_used_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz(6)
  lastUsedAt    DateTime? @map("last_used_at") @db.Timestamptz(6)

  owner  GmIdentity        @relation(fields: [ownerGmId], references: [id])
  client StudioOAuthClient @relation(fields: [clientId], references: [id])
  tokens StudioToken[]
  chatSelections StudioChatSelection[]

  @@index([ownerGmId])
  @@index([clientId])
  @@index([expiresAt])
  @@map("studio_grants")
}

/// A view's current selection, including a short-lived marker after clearing it.
model StudioChatSelection {
  id        String    @id @db.Uuid
  buildId   String    @map("build_id") @db.Uuid
  grantId   String    @map("grant_id") @db.Uuid
  viewId    String    @map("view_id") @db.Uuid
  sequence  Int
  draft     Json?
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)

  build Build       @relation(fields: [buildId], references: [id], onDelete: Cascade)
  grant StudioGrant @relation(fields: [grantId], references: [id], onDelete: Cascade)

  @@unique([buildId, grantId, viewId])
  @@index([grantId])
  @@index([expiresAt])
  @@map("studio_chat_selections")
}

/// An access or refresh token of a grant, by SHA-256 only (design D7).
model StudioToken {
  tokenHash String    @id @map("token_hash")
  grantId   String    @map("grant_id") @db.Uuid
  kind      String
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)

  grant StudioGrant @relation(fields: [grantId], references: [id])

  @@index([grantId])
  @@index([expiresAt])
  @@map("studio_tokens")
}

/// A person's account (FR-GM-01, ADR 0017). Never part of room state.
model User {
  id                String   @id @db.Uuid
  /// Trimmed and lowercased, so the unique index is case-insensitive.
  email             String   @unique
  displayName       String   @map("display_name")
  /// argon2id PHC string; never leaves the server.
  passwordHash      String   @map("password_hash")
  ownerId           String   @unique @map("owner_id") @db.Uuid
  activeDiceLookId  String?  @map("active_dice_look_id") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  passwordChangedAt DateTime @default(now()) @map("password_changed_at") @db.Timestamptz(6)
  /// Null until the address is verified (email-verification). Existing accounts were backfilled.
  emailVerifiedAt   DateTime? @map("email_verified_at") @db.Timestamptz(6)
  credentialVersion Int      @default(0) @map("credential_version")
  referralSource    String?  @map("referral_source")

  owner          GmIdentity   @relation(fields: [ownerId], references: [id])
  activeDiceLook DiceLook?    @relation("ActiveDiceLook", fields: [activeDiceLookId], references: [id], onDelete: SetNull)
  sessions       Session[]
  memberships    RoomMember[]
  verificationTokens EmailVerificationToken[]
  passwordResetTokens PasswordResetToken[]
  feedbackReports FeedbackReport[]

  @@map("users")
}

/// A one-time email verification link (email-verification). Only the token's SHA-256 is stored.
model EmailVerificationToken {
  tokenHash String   @id @map("token_hash")
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  credentialVersion Int @default(0) @map("credential_version")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([expiresAt])
  @@map("email_verification_tokens")
}

/// A one-time password reset link (signup-recovery-hardening). Only the token's SHA-256 is stored.
model PasswordResetToken {
  tokenHash String   @id @map("token_hash")
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  credentialVersion Int @default(0) @map("credential_version")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

/// A sign-in (ADR 0017 I1). Only the cookie token's SHA-256 is stored.
model Session {
  tokenHash  String   @id @map("token_hash")
  userId     String   @map("user_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  lastSeenAt DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  /// Absolute end: created_at + 90 days. Idle end is last_seen_at + 30 days.
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(6)

  user        User         @relation(fields: [userId], references: [id])
  credentials Credential[]

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

/// Which participant a person is in a room (ADR 0017 M1). Access, not game state: kept beside
/// the event log like `credentials`, and never sent to any participant.
model RoomMember {
  roomId        String   @map("room_id") @db.Uuid
  participantId String   @map("participant_id") @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  room Room @relation(fields: [roomId], references: [id])
  user User @relation(fields: [userId], references: [id])

  @@id([roomId, participantId])
  @@unique([roomId, userId])
  @@index([userId])
  @@map("room_members")
}

/// A person's dice look (ADR 0017 O3): up to one picture per die type, in `faces`.
model DiceLook {
  id        String   @id @db.Uuid
  ownerGmId String   @map("owner_gm_id") @db.Uuid
  name      String
  /// { "d20": { "objectKey", "url", "width", "height", "bytes"? }, ... }; object keys never leave the server.
  faces     Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  owner    GmIdentity @relation(fields: [ownerGmId], references: [id])
  activeOf User[]     @relation("ActiveDiceLook")

  @@index([ownerGmId])
  @@map("dice_looks")
}

/// A GM's saved animation (ADR 0038). `def` is the validated AnimationDef.
model LibraryAnimation {
  id        String   @id @db.Uuid
  ownerGmId String   @map("owner_gm_id") @db.Uuid
  name      String
  def       Json
  /// The library folder it is filed under, e.g. its game (docs/adr/0075-library-folders.md); null for none.
  folder    String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  owner GmIdentity @relation(fields: [ownerGmId], references: [id])

  @@index([ownerGmId])
  @@map("library_animations")
}

/// Durable owner-only publication receipt, including after output removal.
model StudioPublication {
  buildId String @map("build_id") @db.Uuid
  operationId String @map("operation_id") @db.Uuid
  inputHash String @map("input_hash")
  receipt Json
  build Build @relation(fields: [buildId], references: [id], onDelete: Cascade)

  @@id([buildId, operationId])
  @@map("studio_publications")
}

/// A GM's stored map or token image. `grid` is set for maps only.
model LibraryAsset {
  id        String   @id @db.Uuid
  ownerGmId String   @map("owner_gm_id") @db.Uuid
  kind      String
  objectKey String   @map("object_key")
  studioOriginal Json? @map("studio_original")
  url       String
  name      String
  width     Int
  height    Int
  /// The stored file's length (upload-limits). Null until recorded, which counts as zero.
  byteSize  Int?     @map("byte_size")
  grid      Json?
  /// Walls and fog prepared on the map (ADR 0037): a LibraryMapBoard, or null for none.
  board     Json?
  sourceHash String? @map("source_hash")
  detectionSourceHash String? @map("detection_source_hash")
  detectionVersion String? @map("detection_version")
  detectionError String? @map("detection_error")
  detectionStatus String? @map("detection_status")
  detectionAttempt Int @default(0) @map("detection_attempt")
  detectionResult Json? @map("detection_result")
  detectionUpdatedAt DateTime? @map("detection_updated_at") @db.Timestamptz(6)
  /// The library folder it is filed under, e.g. its game (docs/adr/0075-library-folders.md); null for none.
  folder    String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  owner     GmIdentity        @relation(fields: [ownerGmId], references: [id])
  creatures LibraryCreature[]
  encounters EncounterTemplate[]

  @@index([ownerGmId, kind])
  @@index([detectionStatus])
  @@map("library_assets")
}

/// A saved encounter board the GM reuses in new or existing rooms (docs/adr/0024-encounter-templates.md).
/// `data` is the validated EncounterTemplateData at `version`. Deleting its map clears `mapAssetId`;
/// the template stays but cannot be applied until the GM fixes it.
model EncounterTemplate {
  id         String   @id @db.Uuid
  ownerGmId  String   @map("owner_gm_id") @db.Uuid
  name       String
  version    Int
  data       Json
  mapAssetId String?  @map("map_asset_id") @db.Uuid
  /// The library folder it is filed under (docs/adr/0075-library-folders.md); null for none.
  folder     String?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  owner GmIdentity    @relation(fields: [ownerGmId], references: [id])
  map   LibraryAsset? @relation(fields: [mapAssetId], references: [id], onDelete: SetNull)
  editingRooms Room[]

  @@index([ownerGmId])
  @@index([mapAssetId])
  @@map("encounter_templates")
}

/// A reusable creature the GM places from Add Token (docs/adr/0012-library-creatures.md).
/// Deleting its token art clears `imageAssetId`; the creature itself stays.
model LibraryCreature {
  id           String   @id @db.Uuid
  ownerGmId    String   @map("owner_gm_id") @db.Uuid
  name         String
  size         Float
  /// Starting HP; null preserves the legacy full-health default (KAN-70).
  hp           Int?
  /// Named to-hit/damage rolls copied into placed tokens (KAN-70).
  attacks      Json     @default("[]")
  maxHp        Int?     @map("max_hp")
  ac           Int?
  /// Disc colour for imageless tokens (KAN-70); null on rows from before it, read as the default.
  color        String?
  /// Conditions placed tokens start with (KAN-70).
  conditions   String[] @default([])
  imageAssetId String?  @map("image_asset_id") @db.Uuid
  /// The library folder it is filed under, e.g. its game (docs/adr/0075-library-folders.md); null for none.
  folder       String?
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  owner GmIdentity    @relation(fields: [ownerGmId], references: [id])
  image LibraryAsset? @relation(fields: [imageAssetId], references: [id], onDelete: SetNull)

  @@index([ownerGmId])
  @@index([imageAssetId])
  @@map("library_creatures")
}

/// Projection: which library assets a room's CURRENT state references (ADR 0004).
/// Derived from RoomState after each commit; never read back into it. No FK to
/// library_assets, and not a uuid column: the id arrives in a client command, so a room may
/// reference an id that is malformed or owned by someone else.
model AssetRef {
  assetId String @map("asset_id")
  roomId  String @map("room_id") @db.Uuid

  room Room @relation(fields: [roomId], references: [id])

  @@id([assetId, roomId])
  @@index([roomId])
  @@map("asset_refs")
}

/// Images uploaded from inside a room via /api/uploads, so deleting the room can remove
/// them (ADR 0009). Library uploads are `library_assets`, never listed here.
model RoomUpload {
  roomId    String @map("room_id") @db.Uuid
  objectKey String @map("object_key")
  purpose String @default("token")
  width Int?
  height Int?
  /// The stored file's length (upload-limits). Null until recorded, which counts as zero.
  byteSize Int? @map("byte_size")
  sourceHash String? @map("source_hash")
  detectionSourceHash String? @map("detection_source_hash")
  detectionVersion String? @map("detection_version")
  detectionError String? @map("detection_error")
  detectionStatus String? @map("detection_status")
  detectionAttempt Int @default(0) @map("detection_attempt")
  detectionResult Json? @map("detection_result")
  detectionUpdatedAt DateTime? @map("detection_updated_at") @db.Timestamptz(6)

  room Room @relation(fields: [roomId], references: [id])

  @@id([roomId, objectKey])
  @@index([roomId])
  @@index([detectionStatus])
  @@map("room_uploads")
}

model Event {
  roomId    String   @map("room_id") @db.Uuid
  seq       Int
  type      String
  payload   Json
  actorId   String?  @map("actor_id") @db.Uuid
  /// One id per committed command batch, so undo reverses a command as a unit (ADR 0013).
  /// Null on events written before undo existed.
  commandId String?  @map("command_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  room Room @relation(fields: [roomId], references: [id])

  @@id([roomId, seq])
  @@map("events")
}

model Credential {
  tokenHash     String    @id @map("token_hash")
  roomId        String    @map("room_id") @db.Uuid
  participantId String    @map("participant_id") @db.Uuid
  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz(6)
  /// The sign-in this seat was created or kept under (ADR 0017 M4); it stops working with it.
  /// Null for guests who never signed in.
  sessionHash   String?   @map("session_hash")

  room    Room     @relation(fields: [roomId], references: [id])
  /// Restrict, not SET NULL: a seat must never outlive its sign-in as a guest seat. The store
  /// deletes a session's credentials itself, in the same transaction as the session.
  session Session? @relation(fields: [sessionHash], references: [tokenHash], onDelete: Restrict)

  @@index([sessionHash])
  @@map("credentials")
}

/// Periodic snapshots for fast room load; state at `seq`.
model Snapshot {
  roomId    String   @map("room_id") @db.Uuid
  seq       Int
  state     Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  room Room @relation(fields: [roomId], references: [id])

  @@id([roomId, seq])
  @@map("snapshots")
}

/// Named checkpoints (FR-REC).
model Checkpoint {
  id        String   @id @db.Uuid
  roomId    String   @map("room_id") @db.Uuid
  name      String
  seq       Int
  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  room Room @relation(fields: [roomId], references: [id])

  @@map("checkpoints")
}

/// Durable private-media write intents and deletion retries. No FK: jobs survive deletion of their build/account.
model StudioMediaJob {
  id        String   @id @db.Uuid
  buildId   String   @map("build_id") @db.Uuid
  state     String
  keys      String[]
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)

  @@index([state, expiresAt])
  @@index([buildId])
  @@map("studio_media_jobs")
}

/// A bug report or idea sent through the Feedback dialog (FR-PL-11, ADR 0079). Read only by the
/// team through `feedback:export`; never served by any route. A signed-in report goes with its account.
model FeedbackReport {
  id             String   @id @db.Uuid
  /// What the reporter is shown, e.g. FB-7Q2K.
  reference      String   @unique
  kind           String
  summary        String
  details        String
  /// The allow-listed technical details (FeedbackTechnical), or null when the reporter left them off.
  technical      Json?
  reporterUserId String?  @map("reporter_user_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  reporter    User?                @relation(fields: [reporterUserId], references: [id], onDelete: Cascade)
  screenshots FeedbackScreenshot[]

  @@index([createdAt])
  @@index([reporterUserId])
  @@map("feedback_reports")
}

/// A report's screenshot, re-encoded to WebP without metadata. Private: kept here, never under /uploads.
model FeedbackScreenshot {
  reportId    String @map("report_id") @db.Uuid
  position    Int
  contentType String @map("content_type")
  width       Int
  height      Int
  bytes       Bytes

  report FeedbackReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@id([reportId, position])
  @@map("feedback_screenshots")
}
