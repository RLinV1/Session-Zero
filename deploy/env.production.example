# Production settings for docker-compose.prod.yml. Copy to .env.production (git-ignored) and fill in.
#   cp deploy/env.production.example .env.production
#   docker compose --env-file .env.production -f docker-compose.prod.yml up -d --build
# Use only letters and digits in passwords and keys (they go into a URL and a JSON file).
# Generate one with: openssl rand -hex 24

# --- Public address -------------------------------------------------------------------------
# CLIENT_ORIGIN: the exact URL users type, no trailing slash. Used for CORS and the write-origin check (ADR 0016).
# Required. Example: https://vtt.example.com, or http://203.0.113.10 on a VM without a domain.
CLIENT_ORIGIN=
# SITE_ADDRESS: what Caddy listens for. ":80" = plain HTTP; a hostname (vtt.example.com) = automatic HTTPS.
SITE_ADDRESS=:80
# COOKIE_SECURE: 1 when CLIENT_ORIGIN is https (the default). Set to 0 only for plain HTTP, or sign-in will not stick.
COOKIE_SECURE=1
# TRUST_PROXY: number of proxies the server sees (Caddy = 1), including behind a CDN. Never "true" in production.
TRUST_PROXY=1
# TRUSTED_PROXIES: proxies in front of Caddy whose X-Forwarded-For it believes. Empty when the VM is reached
# directly. Behind a Cloudflare Tunnel: private_ranges. If it's wrong, all visitors share one set of limits.
TRUSTED_PROXIES=

# --- Cloudflare Tunnel (optional, docs/EDGE-PROTECTION.md) ------------------------------------
# Used by `--profile cloudflare`. Also set SITE_ADDRESS=:80, TRUSTED_PROXIES=private_ranges and an https CLIENT_ORIGIN.
TUNNEL_TOKEN=

# --- Postgres (DATABASE_URL is built from these) ---------------------------------------------
# Required.
POSTGRES_PASSWORD=
POSTGRES_USER=vtt
POSTGRES_DB=vtt

# --- Object storage for uploads (S3_ENDPOINT is set by the compose file to the bundled SeaweedFS) ---
# Required. Server and SeaweedFS both use this key pair.
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Bucket name; the server creates it on first start.
S3_BUCKET=vtt-assets

# Set by docker-compose.prod.yml, listed here so the whole production surface is in one place. On managed
# services (docs/DEPLOYMENT.md section 5) set these in your task or service definition instead:
#   DATABASE_URL  postgres://user:pass@host:5432/db
#   REDIS_URL     redis://host:6379
#   S3_ENDPOINT   https://s3.<region>.amazonaws.com  or  https://storage.googleapis.com
#   VISION_URL    http://vision-host:8000
#   NODE_ENV      production
#   PORT          3001
# Never set SEED_DEV_ACCOUNT in production (it is ignored there anyway).
